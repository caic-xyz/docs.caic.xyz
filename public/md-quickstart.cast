[0.047, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[8A\u001b[38;5;114m●\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mAdded\u001b[1C\u001b[1m2\u001b[1C\u001b[22mlines\r\u001b[1B \u001b[1C   \u001b[38;5;231m\u001b[2m 2 \u001b[22m \u001b[39m    \r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 3 \u001b[22m The opinionated high performance professional-grade AI package for Go.\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 4 \u001b[22m \u001b[39m                                                                                           \r\u001b[1B   \u001b[2C\u001b[38;5;77m\u001b[48;5;22m 5 +\u001b[38;5;231m> Why do Go developers make great AI engineers? Because they already know how to han\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;77m\u001b[48;5;22m   +\u001b[38;5;231mdle `nil` expectations.                                                             \u001b[49m\u001b[39m       \r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m 6 +\u001b[38;5;231m                                                                                    \u001b[49m\u001b[39m     \r\r\r\n\u001b[5C\u001b[38;5;231m\u001b[2m 7\u001b[1C\u001b[22m genai\u001b[1Cis\u001b[1C_intentional_.\u001b[1CCurious\u001b[1Cwhy\u001b[1Cit\u001b[1Cwas\u001b[1Ccreated?\u001b[1CSee\u001b[1Cthe\u001b[1Crelease\u001b[1Cannouncement\u001b[1Cat\u001b[39m\r\r\r\n\u001b[5C\u001b[38;5;231m\u001b[2m 8\u001b[1C\u001b[22m [\u001b[38;5;186mmaruel.ca/post/genai-v0.1.0\u001b[38;5;231m](https://maruel.ca/post/genai-v0.1.0).\u001b[39m\r\r\r\n\u001b[5C\u001b[38;5;231m\u001b[2m 9\u001b[1C\u001b[22m \u001b[39m\r\r\r\n\r\r\r\n\u001b[38;5;174m✽\u001b[1C\u001b[38;5;216mP\u001b[38;5;174mondering…\u001b[39m\r\r\r\n\r\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\r\n\u001b[38;5;246m❯ \u001b[39m\u001b[7m \u001b[27m\r\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\